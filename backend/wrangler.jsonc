{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maraffometro-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Reached only through the Pages service binding: no public workers.dev URL.
  "workers_dev": false,
  // Production. `scripts/setup-cloudflare.sh` creates the database and writes
  // its id here; until then the placeholder only blocks remote commands.
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "maraffometro-db",
      "database_id": "48bbd1d9-9518-4475-87f9-553214de9902",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://maraffometro.pages.dev"
  },
  "env": {
    // `npm run dev`: a local SQLite file under .wrangler/, no Cloudflare
    // account needed. Secrets come from .dev.vars (see .dev.vars.example).
    "local": {
      "d1_databases": [
        {
          "binding": "db",
          "database_name": "db",
          "database_id": "local",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "local",
        "FRONTEND_URL": "http://localhost:5173"
      }
    }
  }
}
