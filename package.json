{
  "name": "maraffometro",
  "private": true,
  "version": "0.1.0",
  "description": "Maraffometro — classifica, statistiche e segnapunti per la Maraffa romagnola",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=11.19.1"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "db:init": "npm run db:migrate:local -w backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "vue-demi@0.14.10": true
  }
}
